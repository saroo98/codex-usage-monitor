<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="RootWindow"
        Title="Codex Usage"
        Width="226"
        Height="78"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="WidgetIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#778396" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                CornerRadius="9"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#EEF2FF" />
                                <Setter Property="Foreground" Value="#4655D8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#E0E7FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="9" x:Name="WidgetRoot" Opacity="0">
        <Border x:Name="Card"
                CornerRadius="19"
                Background="#FCFDFE"
                BorderBrush="#DFE5ED"
                BorderThickness="1"
                Cursor="SizeAll">
            <Border.Effect>
                <DropShadowEffect Color="#273043"
                                  BlurRadius="21"
                                  ShadowDepth="4"
                                  Opacity="0.22" />
            </Border.Effect>
            <Grid Margin="10,7,8,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>

                <Grid Width="44" Height="44" VerticalAlignment="Center">
                    <Ellipse x:Name="ProgressTrack"
                             Stroke="#E5EAF1"
                             StrokeThickness="4" />
                    <Ellipse x:Name="ProgressFull"
                             Stroke="#2FB184"
                             StrokeThickness="4"
                             Visibility="Collapsed" />
                    <Path x:Name="ProgressArc"
                          Stroke="#2FB184"
                          StrokeThickness="4"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                    <TextBlock x:Name="PercentText"
                               Text="--"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#2FB184"
                               FontSize="12.5"
                               FontWeight="SemiBold" />
                </Grid>

                <Border Grid.Column="1"
                        Width="1"
                        Height="34"
                        VerticalAlignment="Center"
                        Background="#E4E9F1" />

                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center"
                            Margin="11,0,6,0">
                    <TextBlock x:Name="UsageLabel"
                               Text="Usage"
                               Foreground="#172033"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="UsageDetail"
                               Margin="0,2,0,0"
                               Text="Waiting for live data"
                               Foreground="#738094"
                               FontSize="11.5"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button Grid.Column="3"
                        x:Name="MenuButton"
                        Style="{StaticResource WidgetIconButtonStyle}"
                        ToolTip="Options">
                    <TextBlock Text="&#xE713;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
