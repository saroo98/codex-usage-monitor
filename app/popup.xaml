<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="RootWindow"
        Title="Codex Usage Notifier"
        Width="520"
        Height="348"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#667085" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                CornerRadius="10"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#EEF2FF" />
                                <Setter Property="Foreground" Value="#4655D8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#E0E7FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="MinWidth" Value="154" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Background" Value="#5664E8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                CornerRadius="12"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#4655D8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#3946C5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1D2939" />
            <Setter Property="BorderBrush" Value="#D7DEE8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#F7F8FC" />
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#C8D1DD" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#EEF1F6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14" x:Name="SlideRoot">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" Y="14" />
        </Grid.RenderTransform>
        <Border x:Name="Card"
                CornerRadius="22"
                Background="#FCFDFE"
                BorderBrush="#E0E6EF"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#273043"
                                  BlurRadius="28"
                                  ShadowDepth="5"
                                  Opacity="0.23" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="66" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="180" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="22,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36"
                            Height="36"
                            CornerRadius="11"
                            VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#7C83FF" Offset="0" />
                                <GradientStop Color="#4F5EDB" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Border Width="19"
                                    Height="19"
                                    CornerRadius="5"
                                    BorderBrush="#DCE1FF"
                                    BorderThickness="1.5"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <RotateTransform Angle="45" />
                                </Border.RenderTransform>
                            </Border>
                            <TextBlock Text="C"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="White"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                        </Grid>
                    </Border>
                    <TextBlock Grid.Column="1"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Text="Codex Usage Notifier"
                               Foreground="#172033"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2"
                               Text="&#xEA8F;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="17"
                               Foreground="#7B8798"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0" />
                    <Button Grid.Column="3"
                            x:Name="CloseButton"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Close">
                        <TextBlock Text="&#xE711;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" />
                    </Button>
                </Grid>

                <Border Grid.Row="1" Background="#E9EDF3" />

                <Grid Grid.Row="2" Margin="24,20,24,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="68" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="54" Height="54" VerticalAlignment="Top" Margin="0,2,0,0">
                        <Ellipse x:Name="StateHalo" Fill="#E9F8F2" />
                        <Ellipse Width="43" Height="43" Fill="#F4FCF9" />
                        <Path x:Name="StateIcon"
                              Data="M 13,27 L 22,36 L 41,16"
                              Stroke="#2FB184"
                              StrokeThickness="4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                    </Grid>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="HeadlineText"
                                   Text="Codex usage available"
                                   Foreground="#172033"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="BodyText"
                                   Grid.Row="1"
                                   Margin="0,6,0,0"
                                   Text="Your usage has increased and is available again."
                                   Foreground="#5D6879"
                                   FontSize="13.5"
                                   LineHeight="20"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   MaxHeight="48" />

                        <Border x:Name="StatusPanel"
                                Grid.Row="2"
                                Margin="0,14,0,0"
                                Height="52"
                                CornerRadius="13"
                                Background="#F7F9FC"
                                BorderBrush="#E4E9F1"
                                BorderThickness="1">
                            <Grid Margin="13,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="27" Height="27" VerticalAlignment="Center">
                                    <Ellipse Stroke="#DFE5ED" StrokeThickness="3" />
                                    <Ellipse x:Name="StatusProgressFull"
                                             Stroke="#2FB184"
                                             StrokeThickness="3"
                                             Visibility="Collapsed" />
                                    <Path x:Name="StatusProgressArc"
                                          Stroke="#2FB184"
                                          StrokeThickness="3"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                </Grid>
                                <TextBlock Grid.Column="1"
                                           x:Name="StatusPercentText"
                                           VerticalAlignment="Center"
                                           Foreground="#20293A"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Text="Usage remaining: 4%" />
                                <Border Grid.Column="2"
                                        Width="1"
                                        Height="24"
                                        VerticalAlignment="Center"
                                        Background="#DFE5ED" />
                                <StackPanel Grid.Column="3"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="14,0,2,0">
                                    <TextBlock Text="&#xE823;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="15"
                                               Foreground="#7A8798"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="StatusResetText"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="#6C7889"
                                               FontSize="13"
                                               Text="Resets in 2h 14m" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Border Grid.Row="3" Background="#E9EDF3" />

                <Grid Grid.Row="4" Margin="24,13,24,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="AutoDismissText"
                               VerticalAlignment="Center"
                               Foreground="#98A2B3"
                               FontSize="11.5"
                               Text="Closes automatically" />
                    <Button Grid.Column="1"
                            x:Name="PrimaryButton"
                            Style="{StaticResource PrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A7;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Open usage"
                                       Margin="9,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3"
                            x:Name="DismissButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="Dismiss" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
