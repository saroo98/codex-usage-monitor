<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>CodexUsageMonitor.App</RootNamespace>
    <AssemblyName>CodexUsageMonitor</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources/App.ico</ApplicationIcon>
    <WindowsPackageType>None</WindowsPackageType>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Resources\App-*.png" />
    <Content Include="Resources\App-*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../CodexUsageMonitor.Application/CodexUsageMonitor.Application.csproj" />
    <ProjectReference Include="../CodexUsageMonitor.Core/CodexUsageMonitor.Core.csproj" />
    <ProjectReference Include="../CodexUsageMonitor.Codex/CodexUsageMonitor.Codex.csproj" />
    <ProjectReference Include="../CodexUsageMonitor.Persistence/CodexUsageMonitor.Persistence.csproj" />
    <ProjectReference Include="../CodexUsageMonitor.Notifications/CodexUsageMonitor.Notifications.csproj" />
    <ProjectReference Include="../CodexUsageMonitor.Email/CodexUsageMonitor.Email.csproj" />
    <ProjectReference Include="../CodexUsageMonitor.Updater/CodexUsageMonitor.Updater.csproj" />
    <ProjectReference Include="../CodexUsageMonitor.Windows/CodexUsageMonitor.Windows.csproj" />
    <ProjectReference Include="../CodexUsageMonitor.Migration/CodexUsageMonitor.Migration.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
</Project>
