<Window x:Class="CodexUsageMonitor.App.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Codex Usage Monitor"
        Width="680"
        Height="620"
        MinWidth="420"
        MinHeight="440"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        AutomationProperties.Name="Codex Usage Monitor onboarding">
  <Grid Margin="30">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Codex usage, without the noise." FontSize="28" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level1" />
      <TextBlock Text="A small native widget that reads your authenticated Codex App Server locally and keeps the last confirmed quota visible." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" Margin="0,8,0,26" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid x:Name="ContentColumns">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="ContentGap" Width="18" /><ColumnDefinition x:Name="RightContentColumn" Width="*" /></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <StackPanel>
        <Border Style="{StaticResource SettingsCardStyle}"><StackPanel>
          <TextBlock Text="1  Local by default" FontSize="16" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
          <TextBlock Text="Usage history stays on this PC. Credentials are protected by Windows. The app does not proxy your Codex traffic." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" />
        </StackPanel></Border>
        <Border Style="{StaticResource SettingsCardStyle}"><StackPanel>
          <TextBlock Text="2  Honest data" FontSize="16" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
          <TextBlock Text="Connection failures never replace confirmed quota with a false zero. Stale readings remain visible and clearly marked." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" />
        </StackPanel></Border>
      </StackPanel>
      <StackPanel x:Name="RightCards" Grid.Column="2">
        <Border Style="{StaticResource SettingsCardStyle}"><StackPanel>
          <TextBlock Text="3  Easy recovery" FontSize="16" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
          <TextBlock Text="Right-click the widget or use the tray icon. Press Ctrl+Shift+U if click-through mode prevents pointer access." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" />
        </StackPanel></Border>
        <Border Style="{StaticResource SettingsCardStyle}"><StackPanel>
          <TextBlock Text="Before you begin" FontSize="16" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
          <TextBlock Text="Install and sign in to the official Codex CLI. The monitor starts its local App Server process only for enabled profiles." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" />
        </StackPanel></Border>
        <Border x:Name="MigrationCard" Style="{StaticResource SettingsCardStyle}" Visibility="Collapsed" AutomationProperties.Name="Previous notifier migration status">
          <StackPanel>
            <TextBlock x:Name="MigrationTitle" Text="Previous notifier found" FontSize="16" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
            <TextBlock x:Name="MigrationBody" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="_Open settings first" Click="OnSettingsClick" Margin="0,0,8,0" />
      <Button Content="_Start monitoring" Style="{StaticResource PrimaryButtonStyle}" Click="OnStartClick" IsDefault="True" />
    </StackPanel>
  </Grid>
</Window>
