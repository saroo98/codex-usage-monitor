<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="SurfaceColor">#FFF5F5F1</Color>
  <Color x:Key="SurfaceElevatedColor">#FFFFFFFF</Color>
  <Color x:Key="SurfaceSubtleColor">#FFECEDE7</Color>
  <Color x:Key="TextPrimaryColor">#FF090B0D</Color>
  <Color x:Key="TextSecondaryColor">#FF3F4A44</Color>
  <Color x:Key="TextMutedColor">#FF68736D</Color>
  <Color x:Key="BorderColor">#24000000</Color>
  <Color x:Key="AccentColor">#FF147653</Color>
  <Color x:Key="AccentStrongColor">#FF0F5D41</Color>
  <Color x:Key="AccentForegroundColor">#FFFFFFFF</Color>
  <Color x:Key="SuccessColor">#FF1E9167</Color>
  <Color x:Key="WarningColor">#FF9A6500</Color>
  <Color x:Key="DangerColor">#FFC9364B</Color>
  <Color x:Key="SuccessTextColor">#FF147653</Color>
  <Color x:Key="WarningTextColor">#FF8A5700</Color>
  <Color x:Key="DangerTextColor">#FFB5223A</Color>
  <Color x:Key="TrackColor">#18000000</Color>
  <Color x:Key="ShadowColor">#30000000</Color>
  <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{DynamicResource SurfaceElevatedColor}" />
  <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="{DynamicResource SurfaceSubtleColor}" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="{DynamicResource TextMutedColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="AccentStrongBrush" Color="{DynamicResource AccentStrongColor}" />
  <SolidColorBrush x:Key="AccentForegroundBrush" Color="{DynamicResource AccentForegroundColor}" />
  <SolidColorBrush x:Key="FocusBrush" Color="{DynamicResource AccentStrongColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}" />
  <SolidColorBrush x:Key="SuccessTextBrush" Color="{DynamicResource SuccessTextColor}" />
  <SolidColorBrush x:Key="WarningTextBrush" Color="{DynamicResource WarningTextColor}" />
  <SolidColorBrush x:Key="DangerTextBrush" Color="{DynamicResource DangerTextColor}" />
  <SolidColorBrush x:Key="TrackBrush" Color="{DynamicResource TrackColor}" />
  <SolidColorBrush x:Key="ShadowBrush" Color="{DynamicResource ShadowColor}" />
</ResourceDictionary>
